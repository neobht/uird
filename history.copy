# Update /etc/initvars with a new variable assignment
# Input: "KEY=value" from stdin
# Replaces existing KEY or appends new one, removes empty lines
update_initvars() {
	local str nv
	read str || return 0
	[ -z "$str" ] && return 0

	nv=$(echo "$str" | awk -F= '{print $1}')
	[ -z "$nv" ] && return 1

	[ -f /etc/initvars ] || : > /etc/initvars

	if grep -q "^${nv}=" /etc/initvars 2>/dev/null; then
		sed -i "s|^${nv}=.*$|${str}|" /etc/initvars
	else
		echo "$str" >> /etc/initvars
	fi

	sed -i '/^$/d' /etc/initvars
}
```

Изменения:
- Добавлено описание функции.
- Добавлены проверки на пустой ввод и пустое имя переменной.
- Упрощена проверка существующей переменной (`^${nv}=` вместо `^[[:space:]]*$nv=`).
- Явное создание файла `/etc/initvars`, если его нет.
- Убран избыточный `grep -q "^$str$"`.

